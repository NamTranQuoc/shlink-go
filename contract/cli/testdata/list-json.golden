tion","shortcut":"-n","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Do not ask any interactive question","default":false}}},"hidden":true},{"name":"integration:matomo:send-visits","description":"Send existing visits to the configured matomo instance","usage":["integration:matomo:send-visits [-s|--since SINCE] [-u|--until UNTIL]"],"help":"This command allows you to send existing visits from this Shlink instance to the configured Matomo server.\n\nIts intention is to allow you to configure Matomo at some point in time, and still have your whole visits \nhistory tracked there.\n\nThis command will unconditionally send to Matomo all visits for a specific date range, so make sure you \nprovide the proper limits to avoid duplicated visits.\n\nSend all visits created so far:\n    <info>integration:matomo:send-visits<\/info>\n\nSend all visits created before 2024:\n    <info>integration:matomo:send-visits --until 2023-12-31<\/info>\n\nSend all visits created after a specific day:\n    <info>integration:matomo:send-visits --since 2022-03-27<\/info>\n\nSend all visits created during 2022:\n    <info>integration:matomo:send-visits --since 2022-01-01 --until 2022-12-31<\/info>","definition":{"arguments":[],"options":{"since":{"name":"--since","shortcut":"-s","accept_value":true,"is_value_required":true,"is_multiple":false,"description":"Only visits created since this date, inclusively, will be sent to Matomo","default":null},"until":{"name":"--until","shortcut":"-u","accept_value":true,"is_value_required":true,"is_multiple":false,"description":"Only visits created until this date, inclusively, will be sent to Matomo","default":null},"help":{"name":"--help","shortcut":"-h","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Display help for the given command. When no command is given display help for the <info>list<\/info> command","default":false},"silent":{"name":"--silent","shortcut":"","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Do not output any message","default":false},"quiet":{"name":"--quiet","shortcut":"-q","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Only errors are displayed. All other output is suppressed","default":false},"verbose":{"name":"--verbose","shortcut":"-v|-vv|-vvv","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Increase the verbosity of messages: 1 for normal output, 2 for more verbose output and 3 for debug","default":false},"version":{"name":"--version","shortcut":"-V","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Display this application version","default":false},"ansi":{"name":"--ansi","shortcut":"","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Force (or disable --no-ansi) ANSI output","default":null},"no-ansi":{"name":"--no-ansi","shortcut":"","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Negate the \"--ansi\" option","default":null},"no-interaction":{"name":"--no-interaction","shortcut":"-n","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Do not ask any interactive question","default":false}}},"hidden":false},{"name":"short-url:create","description":"Generates a short URL for provided long URL and returns it","usage":["short-url:create [-t|--tag TAG] [-s|--valid-since VALID-SINCE] [-u|--valid-until VALID-UNTIL] [-m|--max-visits MAX-VISITS] [--title TITLE] [-r|--crawlable|--no-crawlable] [-w|--no-forward-query|--no-no-forward-query] [-d|--domain DOMAIN] [-c|--custom-slug CUSTOM-SLUG] [-l|--short-code-length SHORT-CODE-LENGTH] [-p|--path-prefix PATH-PREFIX] [-f|--find-if-exists] [--] <long-url>"],"help":"Generates a short URL for provided long URL and returns it","definition":{"arguments":{"long-url":{"name":"long-url","is_required":true,"is_array":false,"description":"The long URL to set","default":null}},"options":{"tag":{"name":"--tag","shortcut":"-t","accept_value":true,"is_value_required":true,"is_multiple":true,"description":"Tags to apply to the short URL","default":[]},"valid-since":{"name":"--valid-since","shortcut":"-s","accept_value":true,"is_value_required":true,"is_multiple":false,"description":"The date from which this short URL will be valid. If someone tries to access it before this date, it will not be found","default":null},"valid-until":{"name":"--valid-until","shortcut":"-u","accept_value":true,"is_value_required":true,"is_multiple":false,"description":"The date until which this short URL will be valid. If someone tries to access it after this date, it will not be found","default":null},"max-visits":{"name":"--max-visits","shortcut":"-m","accept_value":true,"is_value_required":true,"is_multiple":false,"description":"This will limit the number of visits for this short URL","default":null},"title":{"name":"--title","shortcut":"","accept_value":true,"is_value_required":true,"is_multiple":false,"description":"A descriptive title for the short URL","default":null},"crawlable":{"name":"--crawlable","shortcut":"-r","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Tells if this short URL will be included as \"Allow\" in Shlink's robots.txt","default":null},"no-crawlable":{"name":"--no-crawlable","shortcut":"","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Negate the \"--crawlable\" option","default":null},"no-forward-query":{"name":"--no-forward-query","shortcut":"-w","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Disables the forwarding of the query string to the long URL, when the short URL is visited","default":null},"no-no-forward-query":{"name":"--no-no-forward-query","shortcut":"","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Negate the \"--no-forward-query\" option","default":null},"domain":{"name":"--domain","shortcut":"-d","accept_value":true,"is_value_required":true,"is_multiple":false,"description":"The domain to which this short URL will be attached","default":null},"custom-slug":{"name":"--custom-slug","shortcut":"-c","accept_value":true,"is_value_required":true,"is_multiple":false,"description":"If provided, this slug will be used instead of generating a short code","default":null},"short-code-length":{"name":"--short-code-length","shortcut":"-l","accept_value":true,"is_value_required":true,"is_multiple":false,"description":"The length for generated short code (it will be ignored if --custom-slug was provided)","default":null},"path-prefix":{"name":"--path-prefix","shortcut":"-p","accept_value":true,"is_value_required":true,"is_multiple":false,"description":"Prefix to prepend before the generated short code or provided custom slug","default":null},"find-if-exists":{"name":"--find-if-exists","shortcut":"-f","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"This will force existing matching URL to be returned if found, instead of creating a new one","default":false},"help":{"name":"--help","shortcut":"-h","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Display help for the given command. When no command is given display help for the <info>list<\/info> command","default":false},"silent":{"name":"--silent","shortcut":"","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Do not output any message","default":false},"quiet":{"name":"--quiet","shortcut":"-q","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Only errors are displayed. All other output is suppressed","default":false},"verbose":{"name":"--verbose","shortcut":"-v|-vv|-vvv","accept_value":false,"is_value_required":false,"is_multiple":false,"description":"Increase the verbosity of messages: 1 for normal output, 2 for more verbose output and 3 for debug","default":false},"version"