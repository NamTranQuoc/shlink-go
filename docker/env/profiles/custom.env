# Non-default configuration exercised by contract/diff/testdata/custom.cases.json.
BASE_PATH=/s
IS_HTTPS_ENABLED=true
MULTI_SEGMENT_SLUGS_ENABLED=true
SHORT_URL_TRAILING_SLASH=true
SHORT_URL_MODE=loose
DEFAULT_SHORT_CODES_LENGTH=8
REDIRECT_STATUS_CODE=301
REDIRECT_CACHE_LIFETIME=120
REDIRECT_CACHE_VISIBILITY=private
REDIRECT_EXTRA_PATH_MODE=append
DEFAULT_REGULAR_404_REDIRECT=https://example.com/404?from={DOMAIN}&path={ORIGINAL_PATH}
DEFAULT_BASE_URL_REDIRECT=https://example.com/{DOMAIN}/base
DISABLE_TRACK_PARAM=nostat
CORS_ALLOW_ORIGIN=https://a.test,https://b.test
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=600
ROBOTS_ALLOW_ALL_SHORT_URLS=true
ROBOTS_USER_AGENTS=Googlebot,Bingbot
