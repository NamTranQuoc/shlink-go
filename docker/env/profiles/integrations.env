# Real-time updates (Redis, RabbitMQ, Mercure) and Matomo, exercised by contract/integration. Throwaway local credentials.
REDIS_SERVERS=tcp://redis:6379
REDIS_PUB_SUB_ENABLED=true
RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=rabbit
RABBITMQ_PASSWORD=rabbit
# The tests subscribe through the host port, so the public URL is the published one.
MERCURE_PUBLIC_HUB_URL=http://localhost:13080
MERCURE_INTERNAL_HUB_URL=http://mercure
MERCURE_JWT_SECRET=mercure_jwt_key_long_enough_to_be_secure
# The contract tests' helper server captures the tracking requests.
MATOMO_ENABLED=true
MATOMO_BASE_URL=http://host.docker.internal:19999
MATOMO_SITE_ID=3
MATOMO_API_TOKEN=fake_matomo_token
